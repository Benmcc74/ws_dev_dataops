      {
        "type": "Script",
        "typeProperties": {
          "database": "LHDEVBRONZE",
          "scripts": [
            {
              "text": {
                "value": "SELECT\r\n  BRONZE_RAW_ENTITY_ID,\r\n  INTERFACE_ID,\r\n  FABRIC_PIPELINE_NAME,\r\n--  SOURCE_FILE_PATH,\r\n  'C:\\devt\\input' as SOURCE_FILE_PATH,\r\n  REPLACE(\r\n    FILE_NAME,\r\n    'YYYYMMDDHHMMSS',\r\n    FORMAT(CAST(GETDATE() AS DATE), 'yyyyMMdd') + '*'\r\n  ) AS FILE_NAME,\r\n  REPLACE(\r\n    TARGET_FILE_PATH,\r\n    'YYYY/MM/DD',\r\n    FORMAT(CAST(GETDATE() AS DATE), 'yyyy/MM/dd')\r\n  ) AS TARGET_FILE_PATH,\r\n  ISACTIVE\r\nFROM control.cfg_bronze_raw\r\nWHERE\r\n  ISACTIVE = 'Y'\r\nAND INTERFACE_ID = @interface_id;",
                "type": "Expression"
              },
              "type": "Query",
              "parameters": [
                {
                  "name": "interface_id",
                  "type": "String",
                  "value": {
                    "value": "@pipeline().parameters.interface_id",
                    "type": "Expression"
                  },
                  "direction": "Input"
                }
              ]
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
        "externalReferences": {
